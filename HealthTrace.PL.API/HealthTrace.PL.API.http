@HostAddress = https://localhost:7133

# Local demo user (register it first). The token is base64("demo.user:Demo-password-1").
@BasicToken = ZGVtby51c2VyOkRlbW8tcGFzc3dvcmQtMQ==

### Register
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "demo.user",
  "firstName": "Mario",
  "lastName": "Rossi",
  "cf": "RSSMRA80A01H501U",
  "birthDate": "1980-01-01",
  "birthPlace": "Rome",
  "password": "Demo-password-1",
  "passwordConfirmation": "Demo-password-1"
}

### Login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "demo.user",
  "password": "Demo-password-1"
}

### List symptoms
GET {{HostAddress}}/api/symptom
Authorization: Basic {{BasicToken}}

### Filter symptoms by date
GET {{HostAddress}}/api/symptom?date=2026-09-23
Authorization: Basic {{BasicToken}}

### Filter symptoms by (partial) name
GET {{HostAddress}}/api/symptom?name=head
Authorization: Basic {{BasicToken}}

### Get a symptom
GET {{HostAddress}}/api/symptom/1
Authorization: Basic {{BasicToken}}

### Create a symptom
POST {{HostAddress}}/api/symptom
Authorization: Basic {{BasicToken}}
Content-Type: application/json

{
  "eventName": "Headache",
  "description": "Mild, after lunch",
  "eventDate": "2026-09-23T14:30:00"
}

### Update a symptom (route id must match body id)
PUT {{HostAddress}}/api/symptom/1
Authorization: Basic {{BasicToken}}
Content-Type: application/json

{
  "id": 1,
  "eventName": "Headache",
  "description": "Moderate, lasted two hours",
  "eventDate": "2026-09-23T14:30:00"
}

### Delete a symptom (soft delete)
DELETE {{HostAddress}}/api/symptom/1
Authorization: Basic {{BasicToken}}

### Request an export of all symptoms
POST {{HostAddress}}/api/exports/request
Authorization: Basic {{BasicToken}}
Content-Type: application/json

{}

### Request an export for a date range
POST {{HostAddress}}/api/exports/request
Authorization: Basic {{BasicToken}}
Content-Type: application/json

{
  "fromDate": "2026-09-01",
  "toDate": "2026-09-30"
}

### Export history
GET {{HostAddress}}/api/exports
Authorization: Basic {{BasicToken}}

### Export status
GET {{HostAddress}}/api/exports/1
Authorization: Basic {{BasicToken}}

### Download the PDF (409 until Completed)
GET {{HostAddress}}/api/exports/1/download
Authorization: Basic {{BasicToken}}
